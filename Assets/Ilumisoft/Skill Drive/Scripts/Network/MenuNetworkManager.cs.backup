using UnityEngine;
using UnityEngine.UI;
using Photon.Pun;
using Photon.Realtime;

namespace Ilumisoft.SkillDrive.Network
{
    /// <summary>
    /// Menu 씬의 Start 버튼 클릭 시 Photon 네트워크 접속 및 방 생성/참가 처리
    /// </summary>
    public class MenuNetworkManager : MonoBehaviourPunCallbacks
    {
        [Header("UI References")]
        [SerializeField] private Button startButton;
        [SerializeField] private LobbyPanelManager lobbyPanelManager;

        [Header("Network Settings")]
        [SerializeField] private string gameVersion = "1.0";
        [SerializeField] private byte maxPlayersPerRoom = 4;
    [Tooltip("고정 지역 서버 (asia, kr, jp 등). 비워두면 Best Region 자동 선택")]
    [SerializeField] private string fixedRegion = "asia"; // 한국/일본/동남아 함께 사용
    [SerializeField] private string roomNamePrefix = "GameRoom"; // 고정 방 이름 접두사

    private bool isConnecting = false;
    private float reconnectTimer = 0f;
    private int reconnectAttempts = 0;
    private const int MAX_RECONNECT_ATTEMPTS = 3;
            // Start 버튼 이벤트 연결
            if (startButton != null)
            {
                startButton.onClick.AddListener(OnStartButtonClicked);
            }
        }

        private void OnStartButtonClicked()
        {
            if (isConnecting)
            {
                return;
            }

            // PhotonNetwork가 연결되어 있지 않거나, Disconnected 상태면 항상 재접속 시도
            if (!PhotonNetwork.IsConnected || PhotonNetwork.NetworkClientState == Photon.Realtime.ClientState.Disconnected)
            {
                isConnecting = true;
                PhotonNetwork.GameVersion = gameVersion;
                PhotonNetwork.AutomaticallySyncScene = true;
                PhotonNetwork.ConnectUsingSettings();
                return;
            }
            ShowLobby();
        }

        public override void OnConnectedToMaster()
        {
        Debug.Log($"[MenuNetworkManager] Connected to Master Server! Region: {PhotonNetwork.CloudRegion}");
        reconnectAttempts = 0; // 성공 시 재시도 카운터 리셋
        
        // 고정된 방 이름으로 참가 시도 (팀원들이 같은 방에 모이도록)
        string targetRoomName = roomNamePrefix + "_1";
        Debug.Log($"[MenuNetworkManager] Trying to join room: {targetRoomName}");
        PhotonNetwork.JoinRoom(targetRoomName);
public override void OnJoinRoomFailed(short returnCode, string message)
    {
        Debug.LogWarning($"[MenuNetworkManager] Failed to join room: {message} (Code: {returnCode})");
        
        // 방이 없으면 고정된 이름으로 생성
        string roomName = roomNamePrefix + "_1";
        RoomOptions roomOptions = new RoomOptions
        {
            MaxPlayers = maxPlayersPerRoom,
            IsVisible = true,
            IsOpen = true
        };

        Debug.Log($"[MenuNetworkManager] Creating new room: {roomName}");
            PhotonNetwork.CreateRoom(roomName, roomOptions);
        }

        public override void OnJoinedRoom()
        {
            isConnecting = false;
        Debug.Log($"[MenuNetworkManager] ✅ Joined room: {PhotonNetwork.CurrentRoom.Name} (Players: {PhotonNetwork.CurrentRoom.PlayerCount}/{PhotonNetwork.CurrentRoom.MaxPlayers})");

        // LobbyPanel 표시
        ShowLobby();
    }

    public override void OnCreateRoomFailed(short returnCode, string message)
    {
        Debug.LogError($"[MenuNetworkManager] ❌ Failed to create room: {message} (Code: {returnCode})");
        isConnecting = false;
        
        // 방 생성 실패 시 랜덤 방 참가 시도
        Debug.Log("[MenuNetworkManager] Trying to join any available room...");
        PhotonNetwork.JoinRandomRoom();
    }
    
    public override void OnJoinRandomFailed(short returnCode, string message)
    {
        Debug.LogWarning($"[MenuNetworkManager] No available rooms found: {message}");
        // JoinRoomFailed에서 처리됨
        {
        Debug.LogWarning($"[MenuNetworkManager] ⚠️ Disconnected: {cause}");
        isConnecting = false;
        
        // 자동 재연결 시도 (최대 3회)
        if (reconnectAttempts < MAX_RECONNECT_ATTEMPTS && cause != DisconnectCause.DisconnectByClientLogic)
        {
            reconnectAttempts++;
            reconnectTimer = 2f; // 2초 후 재연결
            Debug.Log($"[MenuNetworkManager] Auto-reconnecting in 2 seconds... (Attempt {reconnectAttempts}/{MAX_RECONNECT_ATTEMPTS})");
        }
        else
        {
            Debug.LogError("[MenuNetworkManager] Max reconnect attempts reached or manual disconnect.");
            reconnectAttempts = 0;
        }
    }
    
    private void Update()
    {
        // 재연결 타이머
        if (reconnectTimer > 0)
        {
            reconnectTimer -= Time.deltaTime;
            if (reconnectTimer <= 0)
            {
                Debug.Log("[MenuNetworkManager] Attempting to reconnect...");
                OnStartButtonClicked();
            }
        }
        private void ShowLobby()
        {
            if (lobbyPanelManager != null)
            {
                lobbyPanelManager.ShowLobbyPanel();
            }
            else
            {
                Debug.LogError("[MenuNetworkManager] LobbyPanelManager reference not set!");
            }
        }
    }
}
